{
  "name": "shimmerlab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite build --mode electron && electron electron/main.cjs",
    "desktop:dev": "vite build --mode electron && electron electron/main.cjs",
    "desktop:pack": "vite build --mode electron && electron-builder"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.6",
    "mp4-muxer": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.iconem.shimmerlab",
    "productName": "ShimmerLab",
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "ShimmerLab-portable.exe"
    }
  }
}